{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "quinzo": {
      "type": "object",
      "properties": {
        "publicUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s/]+$"
        },
        "pin": {
          "type": "string",
          "pattern": "^$|^[0-9]{4,8}$"
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "extraEnv": {
          "type": "array"
        },
        "trustProxy": {
          "enum": [
            "auto",
            true,
            false
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        },
        "loadBalancerIP": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod",
            "ReadWriteMany"
          ]
        },
        "size": {
          "type": "string"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "admin": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.@-]{1,64}$"
        },
        "password": {
          "type": "string",
          "pattern": "^$|^.{10,}$"
        },
        "passwordHash": {
          "type": "string",
          "pattern": "^$|^scrypt\\$"
        },
        "existingSecret": {
          "type": "string"
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "password": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_-]{12,}$"
        },
        "serverCommand": {
          "enum": [
            "valkey-server",
            "redis-server"
          ]
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^$|^rediss?://"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "sticky": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cookieName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 60
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    }
  }
}
