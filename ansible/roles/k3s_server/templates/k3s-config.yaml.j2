# Kubeconfig administrateur lisible uniquement par root (jamais par les
# utilisateurs locaux des VM).
write-kubeconfig-mode: "0600"
etcd-expose-metrics: {{ k3s_server_etcd_expose_metrics | lower }}
disable:
{% for component in k3s_server_disabled_components %}
  - {{ component }}
{% endfor %}
tls-san:
  - "{{ vip_ip }}"
kube-apiserver-arg:
  - "oidc-issuer-url=https://auth.smb-111.azby.fr"
  - "oidc-client-id=kubernetes"
  - "oidc-username-claim=preferred_username"
  - "oidc-username-prefix=oidc:"
  - "oidc-groups-claim=groups"
  - "oidc-groups-prefix=oidc:"
# cluster-init uniquement sur le premier master : les autres rejoignent
# le cluster existant via la VIP.
{% if inventory_hostname == groups['masters'][0] %}
cluster-init: true
{% else %}
server: "https://{{ vip_ip }}:6443"
{% endif %}
